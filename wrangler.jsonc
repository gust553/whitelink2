{
  // Configuração do WhiteLink na Cloudflare
  "name": "whitelink",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whitelink-db",
      "database_id": "40a16f0f-e146-4000-9d56-8a241dff9bfe"
    }
  ],
  "routes": [
    { "pattern": "whitelink.site", "custom_domain": true },
    { "pattern": "www.whitelink.site", "custom_domain": true }
  ],
  // todo dia: tira o domínio próprio de quem saiu do Diamante
  "triggers": { "crons": ["23 6 * * *"] },
  "observability": { "enabled": true }
}
